# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and will never be committed.
# ============================================================

# --- Gemini AI (server-side only) ---
# Never expose this to the browser. Used exclusively in server.ts.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Firebase Client SDK ---
# These are safe to ship to the browser (they identify your project),
# but should still be kept out of source control.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"

# --- App URL (optional, used for OAuth callbacks) ---
APP_URL="YOUR_APP_URL"
